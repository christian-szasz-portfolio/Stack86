<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The shared Common.* packages: private, on the organisation's GitHub Packages feed. -->
    <add key="github" value="https://nuget.pkg.github.com/christian-szasz-portfolio/index.json" />
  </packageSources>
  <!-- Common.* comes from the private feed only, so a package of the same name elsewhere is never used. -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Common.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- A token that may read packages, from the environment; no credential is ever committed. -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
