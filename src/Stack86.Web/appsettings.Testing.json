{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost" ]
  },
  "SecurityHeaders": {
    "EnableHsts": false
  },
  "Security": {
    "RateLimiting": {
      "Enabled": false
    }
  },
  "Tcc": {
    "ExecutablePath": "tcc",
    "TimeoutMs": 5000,
    "MaxSourceSizeBytes": 65536
  }
}
