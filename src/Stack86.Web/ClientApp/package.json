{
  "name": "stack86-client",
  "version": "1.0.0",
  "private": true,
  "description": "Stack86 — 8086 compiler & emulator",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1234",
    "dev:build": "vite build --mode development",
    "dev:watch": "vite build --mode development --watch",
    "build": "vite build",
    "preview": "vite preview --port 1234",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:install": "playwright install --with-deps",
    "e2e:report": "playwright show-report",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@angular/build": "^22.1.6",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngrx/store-devtools": "^22.0.0",
    "angular-split": "^20.0.0",
    "monaco-editor": "^0.55.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@oxc-project/runtime": "^0.121.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.5.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.6.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^29.0.1",
    "monocart-reporter": "^2.10.0",
    "sass": "^1.98.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.1",
    "vite-plugin-mkcert": "^1.17.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
