{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Diagnostics": {
    "StorageConnection": "",
    "LogsTableName": "logs",
    "MinimumSeverity": "Warning",
    "Capacity": 5000,
    "LogFlushInterval": "00:00:15"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [ "POST", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type" ]
  },
  "SecurityHeaders": {
    "EnableHsts": true,
    "HstsMaxAgeSeconds": 31536000,
    "EnableContentSecurityPolicy": true,
    "AdditionalConnectSources": []
  },
  "Security": {
    "RateLimiting": {
      "Enabled": true,
      "GeneralApiLimitPerMinute": 100,
      "CompileLimitPerMinute": 20,
      "GeneralApiQueueLimit": 2,
      "CompileQueueLimit": 2,
      "RejectionStatusCode": 429
    }
  },
  "Compilation": {
    "Queue": {
      "MaxConcurrency": 4,
      "QueueCapacity": 8,
      "MaxConcurrentStreams": 4
    }
  },
  "Tcc": {
    "ExecutablePath": "tcc",
    "TimeoutMs": 5000,
    "MaxSourceSizeBytes": 65536
  },
  "TypeScriptTranspiler": {
    "NodePath": "node",
    "ScriptPath": "transpile.cjs",
    "NodeModulesPath": "node_modules",
    "TimeoutMs": 5000,
    "MaxSourceSizeBytes": 65536
  }
}
